{
    "name": "spinningcatstudios/lingara-apps",
    "description": "The official Lingara app kit for PHP: verify, decode and answer Lingara's signed app requests with a card, through any PSR-15 stack.",
    "type": "library",
    "license": "MIT",
    "keywords": ["lingara", "language-learning", "apps", "psr-15", "webhooks"],
    "homepage": "https://getlingara.com",
    "require": {
        "php": ">=8.2",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "spinningcatstudios/lingara": "^0.1.0-alpha.10"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/psr7": "^2.7",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "phpstan/phpstan": "^2.2.1",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "nyholm/psr7": "PSR-7 messages and the PSR-17 factories Psr15Handler takes",
        "nyholm/psr7-server": "Builds the PSR-7 request from PHP's globals",
        "guzzlehttp/psr7": "Another PSR-7 and PSR-17 implementation Psr15Handler works over"
    },
    "autoload": {
        "psr-4": {
            "Lingara\\Apps\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lingara\\Apps\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        },
        "sort-packages": true
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
