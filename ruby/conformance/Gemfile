# frozen_string_literal: true

# The fixture app's server (ADR 30.9.26am D9): conformance only, never in
# the gem's manifest. Ruby has had no standard-library server since 3.0, so
# the fixture runs on WEBrick through Rack; since Rack 3 the WEBrick handler
# lives in `rackup`.
source "https://rubygems.org"

gem "lingara-apps", path: ".."
gem "rack", "3.2.7"
gem "rackup", "2.3.1"
gem "webrick", "1.9.2"
